  code_action {
    action_spec {
      create_file {
        instruction: "import { useMemo, useState, type FormEvent } from \'react\';\nimport {\n  AlertCircle,\n  CheckCircle2,\n  Download,\n  RotateCcw,\n} from \'lucide-react\';\nimport { EVENT_CONFIG } from \'../data/eventData\';\nimport {\n  generatePassDetails,\n  generateQrMatrix,\n  validateRsvpForm,\n  type DiningPreference,\n  type IssuedPass,\n  type ParticipationTrack,\n  type RsvpFormInput,\n  type RsvpValidationErrors,\n  type StudentSection,\n} from \'../utils/partyLogic\';\nimport { downloadPassAsPng } from \'../utils/passExport\';\n\ninterface RsvpPassSectionProps {\n  issuedPass: IssuedPass | null;\n  onIssuePass: (pass: IssuedPass) => void;\n  onResetPass: () => void;\n}\n\nconst SECTIONS: StudentSection[] = [\n  \'Section A\',\n  \'Section B\',\n  \'Section C\',\n  \'Lateral Entry\',\n];\n\nconst DINING_OPTIONS: DiningPreference[] = [\n  \'Vegetarian\',\n  \'Non-Vegetarian\',\n  \'Jain / Vegan\',\n];\n\nconst TRACK_OPTIONS: ParticipationTrack[] = [\n  \'General Entry\',\n  \'Mr. & Ms. AIML Contestant\',\n  \'Stage Performer\',\n];\n\nexport function RsvpPassSection({\n  issuedPass,\n  onIssuePass,\n  onResetPass,\n}: RsvpPassSectionProps) {\n  const [formState, setFormState] = useState<RsvpFormInput>(() => ({\n    fullName: issuedPass?.fullName ?? \'\',\n    rollNumber: issuedPass?.rollNumber ?? \'\',\n    email: issuedPass?.email ?? \'\',\n    section: issuedPass?.section ?? \'Section A\',\n    dining: issuedPass?.dining ?? \'Vegetarian\',\n    track: issuedPass?.track ?? \'General Entry\',\n  }));\n  const [errors, setErrors] = useState<RsvpValidationErrors>({});\n  const [downloadStatus, setDownloadStatus] = useState<string | null>(null);\n\n  const previewPass: IssuedPass = useMemo(() => {\n    if (issuedPass) return issuedPass;\n    const previewInput: RsvpFormInput = {\n      fullName: formState.fullName.trim() || \'Your Name Here\',\n      rollNumber: formState.rollNumber.trim().toUpperCase() || \'26AIML000\',\n      email: formState.email.trim() || \'fresher@aiml.edu\',\n      section: formState.section,\n      dining: formState.dining,\n      track: formState.track,\n    };\n    return generatePassDetails(previewInput, \'2026-12-12T18:00:00.000Z\');\n  }, [issuedPass, formState]);\n\n  const qrMatrix = useMemo(\n    () => generateQrMatrix(previewPass.passCode, 17),\n    [previewPass.passCode]\n  );\n\n  const handleSubmit = (e: FormEvent) => {\n    e.preventDefault();\n    setDownloadStatus(null);\n    const nextErrors = validateRsvpForm(formState);\n    setErrors(nextErrors);\n    if (Object.keys(nextErrors).length > 0) return;\n\n    const pass = generatePassDetails(formState);\n    onIssuePass(pass);\n  };\n\n  const handleDownload = () => {\n    if (!issuedPass) return;\n    const ok = downloadPassAsPng(issuedPass);\n    if (ok) {\n      setDownloadStatus(\'Pass PNG downloaded to your device.\');\n    }\n  };\n\n  const handleReset = () => {\n    onResetPass();\n    setDownloadStatus(null);\n    setErrors({});\n  };\n\n  return (\n    <section\n      id=\"rsvp\"\n      className=\"py-16 lg:py-24 border-b border-white/[0.08] bg-[#0C0C10]\"\n    >\n      <div className=\"max-w-[1280px] mx-auto px-6\">\n        <div className=\"max-w-2xl mb-10\">\n          <p className=\"text-sm text-[#F5A623] font-medium mb-2\">\n            Official Entry Registration\n          </p>\n          <h2 className=\"font-display text-3xl sm:text-4xl font-semibold tracking-tight text-white mb-3\">\n            Claim your Epoch &apos;26 digital pass.\n          </h2>\n          <p className=\"text-sm sm:text-base text-zinc-400 leading-relaxed\">\n            Entry is complimentary for all first-year AIML students. Complete\n            your details to receive your gate assignment, dining counter code,\n            and downloadable QR pass.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start\">\n          {/* Registration Form */}\n          <form\n            onSubmit={handleSubmit}\n            noValidate\n            className=\"lg:col-span-6 rounded-xl border border-white/[0.08] bg-[#121216] p-6 sm:p-8 space-y-5\"\n          >\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label\n                  htmlFor=\"rsvp-name\"\n                  className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                >\n                  Full Name\n                </label>\n                <input\n                  id=\"rsvp-name\"\n                  type=\"text\"\n                  value={formState.fullName}\n                  onChange={(e) =>\n                    setFormState((s) => ({ ...s, fullName: e.target.value }))\n                  }\n                  placeholder=\"e.g. Ananya Sharma\"\n                  aria-invalid={Boolean(errors.fullName)}\n                  className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                />\n                {errors.fullName && (\n                  <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                    <span>{errors.fullName}</span>\n                  </p>\n                )}\n              </div>\n\n              <div>\n                <label\n                  htmlFor=\"rsvp-roll\"\n                  className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                >\n                  Roll Number / Student ID\n                </label>\n                <input\n                  id=\"rsvp-roll\"\n                  type=\"text\"\n                  value={formState.rollNumber}\n                  onChange={(e) =>\n                    setFormState((s) => ({ ...s, rollNumber: e.target.value }))\n                  }\n                  placeholder=\"e.g. 26AIML042\"\n                  aria-invalid={Boolean(errors.rollNumber)}\n                  className=\"w-full px-3.5 py-2.5 text-sm font-mono bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                />\n                {errors.rollNumber && (\n                  <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                    <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                    <span>{errors.rollNumber}</span>\n                  </p>\n                )}\n              </div>\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"rsvp-email\"\n                className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n              >\n                College Email Address\n              </label>\n              <input\n                id=\"rsvp-email\"\n                type=\"email\"\n                value={formState.email}\n                onChange={(e) =>\n                  setFormState((s) => ({ ...s, email: e.target.value }))\n                }\n                placeholder=\"e.g. ananya.sharma@aiml.edu\"\n                aria-invalid={Boolean(errors.email)}\n                className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n              />\n              {errors.email && (\n                <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                  <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                  <span>{errors.email}</span>\n                </p>\n              )}\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n              <div>\n                <label\n                  htmlFor=\"rsvp-section\"\n                  className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                >\n                  Batch Section\n                </label>\n                <select\n                  id=\"rsvp-section\"\n                  value={formState.section}\n                  onChange={(e) =>\n                    setFormState((s) => ({\n                      ...s,\n                      section: e.target.value as StudentSection,\n                    }))\n                  }\n                  className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white focus:border-[#F5A623]\"\n                >\n                  {SECTIONS.map((sec) => (\n                    <option key={sec} value={sec}>\n                      {sec}\n                    </option>\n                  ))}\n                </select>\n              </div>\n\n              <div>\n                <label\n                  htmlFor=\"rsvp-dining\"\n                  className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                >\n                  Dining Preference\n                </label>\n                <select\n                  id=\"rsvp-dining\"\n                  value={formState.dining}\n                  onChange={(e) =>\n                    setFormState((s) => ({\n                      ...s,\n                      dining: e.target.value as DiningPreference,\n                    }))\n                  }\n                  className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white focus:border-[#F5A623]\"\n                >\n                  {DINING_OPTIONS.map((opt) => (\n                    <option key={opt} value={opt}>\n                      {opt}\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"rsvp-track\"\n                className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n              >\n                Participation Track\n              </label>\n              <select\n                id=\"rsvp-track\"\n                value={formState.track}\n                onChange={(e) =>\n                  setFormState((s) => ({\n                    ...s,\n                    track: e.target.value as ParticipationTrack,\n                  }))\n                }\n                className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white focus:border-[#F5A623]\"\n              >\n                {TRACK_OPTIONS.map((track) => (\n                  <option key={track} value={track}>\n                    {track}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            <div className=\"pt-2 flex flex-wrap items-center gap-3\">\n              <button\n                type=\"submit\"\n                className=\"px-6 py-3 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap shrink-0\"\n              >\n                {issuedPass ? \'Update Entry Pass\' : \'Generate Entry Pass\'}\n              </button>\n\n              {issuedPass && (\n                <button\n                  type=\"button\"\n                  onClick={handleReset}\n                  className=\"inline-flex items-center gap-2 px-4 py-3 text-sm font-medium text-zinc-300 hover:text-white border border-white/15 hover:border-white/30 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                >\n                  <RotateCcw className=\"w-4 h-4\" aria-hidden=\"true\" />\n                  <span>Clear Pass</span>\n                </button>\n              )}\n            </div>\n          </form>\n\n          {/* Live / Issued Digital Entry Pass Card */}\n          <div className=\"lg:col-span-6 space-y-4\">\n            <div\n              data-testid=\"digital-entry-pass\"\n              className=\"rounded-xl border border-white/[0.12] bg-[#121216] overflow-hidden\"\n            >\n              {/* Top amber hairline bar */}\n              <div className=\"h-1.5 bg-[#F5A623]\" />\n\n              <div className=\"p-6 sm:p-8\">\n                {/* Pass Header */}\n                <div className=\"flex flex-wrap items-center justify-between gap-2 pb-5 border-b border-white/[0.08]\">\n                  <div>\n                    <div className=\"text-xs text-[#F5A623] font-medium\">\n                      {EVENT_CONFIG.department} \302\267 {EVENT_CONFIG.batchLabel}\n                    </div>\n                    <h3 className=\"font-display text-2xl font-semibold text-white mt-1\">\n                      {EVENT_CONFIG.brandName} Official Entry Pass\n                    </h3>\n                  </div>\n\n                  <div className=\"text-xs font-medium flex items-center gap-1.5\">\n                    {issuedPass ? (\n                      <span className=\"text-emerald-400 inline-flex items-center gap-1.5\">\n                        <CheckCircle2 className=\"w-4 h-4\" aria-hidden=\"true\" />\n                        Pass Issued\n                      </span>\n                    ) : (\n                      <span className=\"text-zinc-400\">Live Preview</span>\n                    )}\n                  </div>\n                </div>\n\n                {/* Pass Body: Details + Deterministic SVG QR */}\n                <div className=\"py-6 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center\">\n                  <div className=\"sm:col-span-8 space-y-4\">\n                    <div>\n                      <div className=\"text-xs text-zinc-400\">Attendee</div>\n                      <div className=\"font-display text-2xl font-semibold text-white mt-0.5 break-words\">\n                        {previewPass.fullName}\n                      </div>\n                      <div className=\"text-xs font-mono tabular-nums text-zinc-300 mt-1\">\n                        {previewPass.rollNumber} \302\267 {previewPass.section}\n                      </div>\n                    </div>\n\n                    <dl className=\"grid grid-cols-2 gap-4 pt-3 border-t border-white/[0.08]\">\n                      <div>\n                        <dt className=\"text-xs text-zinc-400\">Check-In Gate</dt>\n                        <dd className=\"text-sm font-medium text-white mt-0.5\">\n                          {previewPass.gate}\n                        </dd>\n                      </div>\n                      <div>\n                        <dt className=\"text-xs text-zinc-400\">Dining Lane</dt>\n                        <dd className=\"text-sm font-mono font-medium text-white mt-0.5\">\n                          {previewPass.diningCode} ({previewPass.dining})\n                        </dd>\n                      </div>\n                      <div className=\"col-span-2\">\n                        <dt className=\"text-xs text-zinc-400\">Event Track</dt>\n                        <dd className=\"text-sm font-medium text-zinc-200 mt-0.5\">\n                          {previewPass.track}\n                        </dd>\n                      </div>\n                    </dl>\n                  </div>\n\n                  {/* Deterministic QR Block */}\n                  <div className=\"sm:col-span-4 flex flex-col items-center justify-center sm:border-l sm:border-dashed sm:border-white/15 sm:pl-6\">\n                    <div className=\"p-2.5 bg-white rounded-lg\">\n                      <svg\n                        viewBox=\"0 0 17 17\"\n                        width=\"112\"\n                        height=\"112\"\n                        role=\"img\"\n                        aria-label={`QR verification code for pass ${previewPass.passCode}`}\n                        className=\"block\"\n                      >\n                        <rect width=\"17\" height=\"17\" fill=\"#FFFFFF\" />\n                        {qrMatrix.map((row, r) =>\n                          row.map((filled, c) =>\n                            filled ? (\n                              <rect\n                                key={`${r}-${c}`}\n                                x={c}\n                                y={r}\n                                width={1}\n                                height={1}\n                                fill=\"#09090B\"\n                              />\n                            ) : null\n                          )\n                        )}\n                      </svg>\n                    </div>\n                    <div className=\"mt-3 text-center\">\n                      <div className=\"text-[11px] text-zinc-400\">Pass ID</div>\n                      <div className=\"font-mono tabular-nums text-sm font-medium text-[#F5A623]\">\n                        {previewPass.passCode}\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                {/* Pass Footer */}\n                <div className=\"pt-4 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-3 text-xs text-zinc-400\">\n                  <span className=\"font-mono tabular-nums\">\n                    {EVENT_CONFIG.dateDisplay} \302\267 18:00\n                  </span>\n                  <span>Valid with College ID at North Atrium</span>\n                </div>\n              </div>\n            </div>\n\n            {/* Download action when issued */}\n            <div className=\"flex flex-wrap items-center justify-between gap-4\">\n              {issuedPass ? (\n                <button\n                  type=\"button\"\n                  onClick={handleDownload}\n                  className=\"inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-[#1D1D24] hover:bg-[#262630] border border-white/15 rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                >\n                  <Download className=\"w-4 h-4 text-[#F5A623]\" aria-hidden=\"true\" />\n                  <span>Download Pass (PNG)</span>\n                </button>\n              ) : (\n                <p className=\"text-xs text-zinc-400\">\n                  Submit the registration form to lock in your pass code and\n                  enable PNG download.\n                </p>\n              )}\n\n              {downloadStatus && (\n                <p\n                  role=\"status\"\n                  className=\"text-xs text-emerald-400 flex items-center gap-1.5\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n                  <span>{downloadStatus}</span>\n                </p>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
