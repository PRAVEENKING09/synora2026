  code_action {
    action_spec {
      create_file {
        instruction: "import { COORDINATORS, EVENT_CONFIG } from \'../data/eventData\';\n\nexport function Footer() {\n  return (\n    <footer className=\"bg-[#09090B] py-14\">\n      <div className=\"max-w-[1280px] mx-auto px-6\">\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-10 pb-10 border-b border-white/[0.08]\">\n          <div className=\"md:col-span-5 space-y-3\">\n            <a\n              href=\"#top\"\n              className=\"font-display text-2xl font-semibold tracking-tight text-white inline-block\"\n            >\n              {EVENT_CONFIG.brandName}\n            </a>\n            <p className=\"text-sm text-zinc-400 max-w-sm leading-relaxed\">\n              Hosted by the Student Council of the {EVENT_CONFIG.department} to\n              welcome the {EVENT_CONFIG.batchLabel}.\n            </p>\n            <p className=\"text-xs font-mono text-zinc-500\">\n              {EVENT_CONFIG.dateDisplay} \302\267 {EVENT_CONFIG.venueShort}\n            </p>\n          </div>\n\n          <div className=\"md:col-span-5\">\n            <h3 className=\"text-xs font-semibold text-white mb-4\">\n              Student Organizing Committee\n            </h3>\n            <ul className=\"space-y-3\">\n              {COORDINATORS.map((coord) => (\n                <li key={coord.email ?? coord.contact} className=\"text-sm\">\n                  <div className=\"text-zinc-200 font-medium\">{coord.name}</div>\n                  <div className=\"text-xs text-zinc-400 flex flex-wrap items-center gap-x-2\">\n                    <span>{coord.role}</span>\n                    <span aria-hidden=\"true\">\302\267</span>\n                    <a\n                      href={`mailto:${coord.contact}`}\n                      className=\"text-zinc-300 hover:text-[#F5A623] transition-colors\"\n                    >\n                      {coord.contact}\n                    </a>\n                  </div>\n                </li>\n              ))}\n            </ul>\n          </div>\n\n          <div className=\"md:col-span-2\">\n            <h3 className=\"text-xs font-semibold text-white mb-4\">Quick Links</h3>\n            <ul className=\"space-y-2.5 text-sm text-zinc-400\">\n              <li>\n                <a href=\"#lineup\" className=\"hover:text-white transition-colors\">\n                  Lineup\n                </a>\n              </li>\n              <li>\n                <a href=\"#schedule\" className=\"hover:text-white transition-colors\">\n                  Schedule\n                </a>\n              </li>\n              <li>\n                <a href=\"#dresscode\" className=\"hover:text-white transition-colors\">\n                  Dress Code\n                </a>\n              </li>\n              <li>\n                <a href=\"#spotlight\" className=\"hover:text-white transition-colors\">\n                  Song Queue\n                </a>\n              </li>\n              <li>\n                <a href=\"#rsvp\" className=\"hover:text-white transition-colors\">\n                  Entry Pass\n                </a>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div className=\"pt-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-zinc-500\">\n          <p>\n            \302\251 2026 {EVENT_CONFIG.department} \302\267 Freshers&apos; Organizing Committee.\n          </p>\n          <p>Block C Grand Auditorium &amp; North Courtyard</p>\n        </div>\n      </div>\n    </footer>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/Footer.tsx"
        }
        overwrite: true
      }
    }
