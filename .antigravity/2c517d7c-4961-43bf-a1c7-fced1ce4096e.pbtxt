      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update HTML title, metadata, and Google Fonts (Bricolage Grotesque, Plus Jakarta Sans, JetBrains Mono) in index.html\", \"EndLine\":17, \"Instruction\":\"Update index.html title, meta tags, and Google Fonts links\", \"ReplacementContent\":\"<!doctype html>\\n<html lang=\\\"en\\\" class=\\\"scroll-smooth\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>Epoch \'26 \342\200\224 AIML Department Freshers\' Night</title>\\n    <meta name=\\\"description\\\" content=\\\"Official freshers\' party website for the Department of AI & Machine Learning (Batch of 2026\342\200\2232030), featuring the evening schedule, lineup, dress code lookbook, DJ song requests, Mr. & Ms. AIML sign-ups, and digital entry pass registration.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"Epoch \'26 \342\200\224 AIML Department Freshers\' Night\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"Welcome to your first evening at AIML. Saturday, December 12, 2026 at the Grand Auditorium & Courtyard.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\" />\\n    <link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin />\\n    <link\\n      href=\\\"https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap\\\"\\n      rel=\\\"stylesheet\\\"\\n    />\\n  </head>\\n  <body class=\\\"bg-[#09090B] text-[#F4F4F5] antialiased selection:bg-[#F5A623] selection:text-[#09090B]\\\">\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"StartLine\":1, \"TargetContent\":\"<!doctype html>\\n<html lang=\\\"en\\\">\\n  <head>\\n    <meta charset=\\\"UTF-8\\\" />\\n    <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n    <title>My Google AI Studio App</title>\\n    <meta name=\\\"description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:title\\\" content=\\\"My Google AI Studio App\\\" />\\n    <meta property=\\\"og:description\\\" content=\\\"An application built with Google AI Studio.\\\" />\\n    <meta property=\\\"og:type\\\" content=\\\"website\\\" />\\n    <meta name=\\\"twitter:card\\\" content=\\\"summary_large_image\\\" />\\n  </head>\\n  <body>\\n    <div id=\\\"root\\\"></div>\\n    <script type=\\\"module\\\" src=\\\"/src/main.tsx\\\"></script>\\n  </body>\\n</html>\", \"TargetFile\":\"/index.html\", \"toolAction\":\"Updating index.html metadata and fonts\", \"toolSummary\":\"Update index.html\"}"
