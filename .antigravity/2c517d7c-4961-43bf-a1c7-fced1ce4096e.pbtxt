  code_action {
    action_spec {
      create_file {
        instruction: "import { useState } from \'react\';\nimport { Bookmark, Check } from \'lucide-react\';\nimport { SCHEDULE_ITEMS } from \'../data/eventData\';\nimport { filterSchedule, type ScheduleFilter } from \'../utils/partyLogic\';\n\ninterface ScheduleSectionProps {\n  savedIds: string[];\n  onToggleSave: (id: string) => void;\n}\n\nconst FILTERS: { id: ScheduleFilter; label: string }[] = [\n  { id: \'all\', label: \'All Events\' },\n  { id: \'stage\', label: \'Stage\' },\n  { id: \'social\', label: \'Social\' },\n  { id: \'dining\', label: \'Dining\' },\n  { id: \'saved\', label: \'My Plan\' },\n];\n\nexport function ScheduleSection({ savedIds, onToggleSave }: ScheduleSectionProps) {\n  const [activeFilter, setActiveFilter] = useState<ScheduleFilter>(\'all\');\n\n  const visibleItems = filterSchedule(SCHEDULE_ITEMS, activeFilter, savedIds);\n\n  return (\n    <section\n      id=\"schedule\"\n      className=\"py-16 lg:py-24 border-b border-white/[0.08] bg-[#0C0C10]\"\n    >\n      <div className=\"max-w-[1280px] mx-auto px-6\">\n        <div className=\"flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-10\">\n          <div>\n            <p className=\"text-sm text-[#F5A623] font-medium mb-2\">\n              Evening Schedule\n            </p>\n            <h2 className=\"font-display text-3xl sm:text-4xl font-semibold tracking-tight text-white\">\n              Five and a half hours, zero dead air.\n            </h2>\n          </div>\n\n          {/* Interactive segmented filter controls */}\n          <div\n            role=\"group\"\n            aria-label=\"Filter evening schedule\"\n            className=\"inline-flex flex-wrap items-center gap-1 p-1 rounded-lg bg-[#16161C] border border-white/[0.08] self-start lg:self-auto\"\n          >\n            {FILTERS.map((filter) => {\n              const isActive = activeFilter === filter.id;\n              const label =\n                filter.id === \'saved\'\n                  ? `My Plan (${savedIds.length})`\n                  : filter.label;\n              return (\n                <button\n                  key={filter.id}\n                  type=\"button\"\n                  onClick={() => setActiveFilter(filter.id)}\n                  aria-pressed={isActive}\n                  className={`px-3.5 py-2 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                    isActive\n                      ? \'bg-[#F5A623] text-[#09090B]\'\n                      : \'text-zinc-300 hover:text-white hover:bg-white/5\'\n                  }`}\n                >\n                  {label}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Chronological Schedule Rows */}\n        {visibleItems.length === 0 ? (\n          <div className=\"rounded-xl border border-white/[0.08] bg-[#121216] p-10 text-center\">\n            <p className=\"text-base font-medium text-white mb-2\">\n              Your personal itinerary is empty.\n            </p>\n            <p className=\"text-sm text-zinc-400 mb-5\">\n              Bookmark any session from the full timeline to keep your favorite\n              performances and dining slots handy.\n            </p>\n            <button\n              type=\"button\"\n              onClick={() => setActiveFilter(\'all\')}\n              className=\"px-4 py-2 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap\"\n            >\n              Browse All Events\n            </button>\n          </div>\n        ) : (\n          <div\n            data-testid=\"schedule-list\"\n            className=\"divide-y divide-white/[0.08] border-y border-white/[0.08]\"\n          >\n            {visibleItems.map((item) => {\n              const isSaved = savedIds.includes(item.id);\n              return (\n                <div\n                  key={item.id}\n                  className=\"py-6 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-start\"\n                >\n                  {/* Timestamp & Duration */}\n                  <div className=\"md:col-span-2 flex md:flex-col items-baseline gap-3 md:gap-1\">\n                    <span className=\"font-mono tabular-nums text-lg font-medium text-white\">\n                      {item.time}\n                    </span>\n                    <span className=\"font-mono tabular-nums text-xs text-zinc-400\">\n                      {item.duration}\n                    </span>\n                  </div>\n\n                  {/* Content & Unboxed Metadata */}\n                  <div className=\"md:col-span-7 space-y-2\">\n                    <div className=\"flex flex-wrap items-center gap-2 text-xs text-zinc-400\">\n                      <span className=\"text-[#F5A623] font-medium\">\n                        {item.categoryLabel}\n                      </span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>{item.location}</span>\n                      {item.lead && (\n                        <>\n                          <span aria-hidden=\"true\">\302\267</span>\n                          <span>{item.lead}</span>\n                        </>\n                      )}\n                    </div>\n                    <h3 className=\"font-display text-xl font-semibold text-white\">\n                      {item.title}\n                    </h3>\n                    <p className=\"text-sm text-zinc-400 leading-relaxed max-w-2xl\">\n                      {item.description}\n                    </p>\n                  </div>\n\n                  {/* Action Toggle */}\n                  <div className=\"md:col-span-3 flex md:justify-end\">\n                    <button\n                      type=\"button\"\n                      onClick={() => onToggleSave(item.id)}\n                      aria-pressed={isSaved}\n                      aria-label={\n                        isSaved\n                          ? `Remove ${item.title} from my plan`\n                          : `Add ${item.title} to my plan`\n                      }\n                      className={`inline-flex items-center gap-2 px-4 py-2 text-xs sm:text-sm font-medium rounded-lg border transition-colors whitespace-nowrap shrink-0 ${\n                        isSaved\n                          ? \'bg-[#F5A623]/15 border-[#F5A623]/50 text-[#F5A623]\'\n                          : \'bg-transparent border-white/15 text-zinc-200 hover:border-white/30 hover:text-white\'\n                      }`}\n                    >\n                      {isSaved ? (\n                        <>\n                          <Check className=\"w-4 h-4\" aria-hidden=\"true\" />\n                          <span>In My Plan</span>\n                        </>\n                      ) : (\n                        <>\n                          <Bookmark className=\"w-4 h-4\" aria-hidden=\"true\" />\n                          <span>Add to Plan</span>\n                        </>\n                      )}\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/ScheduleSection.tsx"
        }
        overwrite: true
      }
    }
