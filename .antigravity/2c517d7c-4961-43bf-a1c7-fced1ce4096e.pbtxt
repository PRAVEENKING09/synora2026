.sharma@aiml.edu\n          - generic [ref=e389]:\n            - generic [ref=e390]:\n              - generic [ref=e391]: Batch Section\n              - combobox \"Batch Section\" [ref=e392]:\n                - option \"Section A\" [selected]\n                - option \"Section B\"\n                - option \"Section C\"\n                - option \"Lateral Entry\"\n            - generic [ref=e393]:\n              - generic [ref=e394]: Dining Preference\n              - combobox \"Dining Preference\" [ref=e395]:\n                - option \"Vegetarian\" [selected]\n                - option \"Non-Vegetarian\"\n                - option \"Jain / Vegan\"\n          - generic [ref=e396]:\n            - generic [ref=e397]: Participation Track\n            - combobox \"Participation Track\" [ref=e398]:\n              - option \"General Entry\" [selected]\n              - option \"Mr. & Ms. AIML Contestant\"\n              - option \"Stage Performer\"\n          - button \"Generate Entry Pass\" [ref=e400]\n        - generic [ref=e401]:\n          - generic [ref=e404]:\n            - generic [ref=e405]:\n              - generic [ref=e406]:\n                - generic [ref=e407]: Department of AI & Machine Learning \302\267 Batch of 2026\342\200\2232030\n                - heading \"Epoch \'26 Official Entry Pass\" [level=3] [ref=e408]\n              - generic [ref=e409]: Live Preview\n            - generic [ref=e411]:\n              - generic [ref=e412]:\n                - generic [ref=e413]:\n                  - generic [ref=e414]: Attendee\n                  - generic [ref=e415]: Your Name Here\n                  - generic [ref=e416]: 26AIML000 \302\267 Section A\n                - generic [ref=e417]:\n                  - generic [ref=e418]:\n                    - term [ref=e419]: Check-In Gate\n                    - definition [ref=e420]: North Atrium \302\267 Gate 1\n                  - generic [ref=e421]:\n                    - term [ref=e422]: Dining Lane\n                