  code_action {
    action_spec {
      create_file {
        instruction: "import { useState } from \'react\';\nimport { Menu, X } from \'lucide-react\';\nimport { EVENT_CONFIG } from \'../data/eventData\';\n\ninterface NavbarProps {\n  hasIssuedPass: boolean;\n}\n\nconst NAV_LINKS = [\n  { href: \'#lineup\', label: \'Lineup\' },\n  { href: \'#schedule\', label: \'Schedule\' },\n  { href: \'#dresscode\', label: \'Dress Code\' },\n  { href: \'#spotlight\', label: \'Song Queue\' },\n  { href: \'#venue\', label: \'Venue\' },\n];\n\nexport function Navbar({ hasIssuedPass }: NavbarProps) {\n  const [mobileOpen, setMobileOpen] = useState(false);\n\n  return (\n    <header className=\"sticky top-0 z-40 bg-[#09090B]/90 backdrop-blur-md border-b border-white/[0.08]\">\n      <div className=\"max-w-[1280px] mx-auto px-6 h-16 flex items-center justify-between gap-8\">\n        {/* Zone 1: Single text element wordmark */}\n        <a\n          href=\"#top\"\n          className=\"font-display text-xl font-semibold tracking-tight text-white whitespace-nowrap shrink-0 hover:text-[#F5A623] transition-colors\"\n        >\n          {EVENT_CONFIG.brandName}\n        </a>\n\n        {/* Zone 2: 5 concise single-line navigation links */}\n        <nav\n          aria-label=\"Primary navigation\"\n          className=\"hidden md:flex items-center gap-7 text-sm font-medium text-zinc-400\"\n        >\n          {NAV_LINKS.map((link) => (\n            <a\n              key={link.href}\n              href={link.href}\n              className=\"whitespace-nowrap shrink-0 hover:text-white underline-offset-8 hover:underline decoration-[#F5A623]/70 transition-colors\"\n            >\n              {link.label}\n            </a>\n          ))}\n        </nav>\n\n        {/* Zone 3: Single primary CTA + mobile menu toggle */}\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <a\n            href=\"#rsvp\"\n            className=\"inline-flex items-center justify-center px-4 py-2 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap shrink-0\"\n          >\n            {hasIssuedPass ? \'View Entry Pass\' : \'Claim Entry Pass\'}\n          </a>\n\n          <button\n            type=\"button\"\n            onClick={() => setMobileOpen((prev) => !prev)}\n            aria-expanded={mobileOpen}\n            aria-controls=\"mobile-nav-drawer\"\n            aria-label={mobileOpen ? \'Close navigation menu\' : \'Open navigation menu\'}\n            className=\"md:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg border border-white/10 text-zinc-200 hover:bg-white/5 transition-colors shrink-0\"\n          >\n            {mobileOpen ? (\n              <X className=\"w-5 h-5\" aria-hidden=\"true\" />\n            ) : (\n              <Menu className=\"w-5 h-5\" aria-hidden=\"true\" />\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Mobile collapsible menu (only rendered when opened so sticky height stays compact) */}\n      {mobileOpen && (\n        <nav\n          id=\"mobile-nav-drawer\"\n          aria-label=\"Mobile navigation\"\n          className=\"md:hidden border-t border-white/[0.08] bg-[#0E0E12] px-6 py-4 flex flex-col gap-1\"\n        >\n          {NAV_LINKS.map((link) => (\n            <a\n              key={link.href}\n              href={link.href}\n              onClick={() => setMobileOpen(false)}\n              className=\"py-2.5 text-base font-medium text-zinc-300 hover:text-white transition-colors\"\n            >\n              {link.label}\n            </a>\n          ))}\n        </nav>\n      )}\n    </header>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
