  code_action {
    action_spec {
      create_file {
        instruction: "import { EVENT_IMAGES } from \'../data/eventData\';\nimport { ResilientImage } from \'./ResilientImage\';\n\nexport function HighlightsBento() {\n  return (\n    <section\n      id=\"lineup\"\n      className=\"py-16 lg:py-24 border-b border-white/[0.08]\"\n    >\n      <div className=\"max-w-[1280px] mx-auto px-6\">\n        <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10\">\n          <div className=\"max-w-xl\">\n            <p className=\"text-sm text-[#F5A623] font-medium mb-2\">\n              The Evening Lineup\n            </p>\n            <h2 className=\"font-display text-3xl sm:text-4xl font-semibold tracking-tight text-white\">\n              Four signature moments built for the Batch of 2030.\n            </h2>\n          </div>\n          <p className=\"text-sm text-zinc-400 max-w-sm\">\n            From the auditorium spotlight to open-air music under the courtyard\n            arches\342\200\224every segment is student-produced by AIML seniors.\n          </p>\n        </div>\n\n        {/* Asymmetric Bento Grid: 2-col feature + 1-col spotlight on row 1, balanced editorial blocks on row 2 */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {/* Card 1: Marquee 2-column visual card */}\n          <article className=\"lg:col-span-2 relative rounded-xl overflow-hidden border border-white/[0.08] bg-[#121216] min-h-[340px] flex flex-col justify-end\">\n            <ResilientImage\n              src={EVENT_IMAGES.djAfterparty}\n              alt=\"Open-air courtyard DJ console surrounded by AIML students under warm golden lights\"\n              fallbackTitle=\"01. Courtyard DJ Afterparty\"\n              className=\"absolute inset-0 w-full h-full object-cover\"\n            />\n            <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#09090B] via-[#09090B]/55 to-transparent\" />\n            <div className=\"relative z-10 p-6 sm:p-8 max-w-xl\">\n              <div className=\"flex flex-wrap items-center gap-2 text-xs text-zinc-300 font-mono tabular-nums mb-2\">\n                <span>22:00 \342\200\223 23:30</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>North Courtyard Stage</span>\n              </div>\n              <h3 className=\"font-display text-2xl sm:text-3xl font-semibold text-white mb-2\">\n                01. Open-Air DJ Set &amp; Afterparty\n              </h3>\n              <p className=\"text-sm sm:text-base text-zinc-300 leading-relaxed\">\n                House grooves, Bollywood floor-fillers, and hip-hop sets spun\n                live by DJ Aarav. The final 30-minute encore is built directly\n                from the fresher song queue below.\n              </p>\n            </div>\n          </article>\n\n          {/* Card 2: 1-column stage spotlight */}\n          <article className=\"relative rounded-xl overflow-hidden border border-white/[0.08] bg-[#121216] min-h-[340px] flex flex-col justify-end\">\n            <ResilientImage\n              src={EVENT_IMAGES.stageSpotlight}\n              alt=\"Single warm amber spotlight illuminating a performer on the Grand Auditorium runway\"\n              fallbackTitle=\"02. Mr. & Ms. AIML 2026\"\n              className=\"absolute inset-0 w-full h-full object-cover\"\n            />\n            <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#09090B] via-[#09090B]/60 to-transparent\" />\n            <div className=\"relative z-10 p-6 sm:p-8\">\n              <div className=\"flex flex-wrap items-center gap-2 text-xs text-zinc-300 font-mono tabular-nums mb-2\">\n                <span>20:00 \342\200\223 21:15</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>Main Runway</span>\n              </div>\n              <h3 className=\"font-display text-2xl font-semibold text-white mb-2\">\n                02. Mr. &amp; Ms. AIML &apos;26\n              </h3>\n              <p className=\"text-sm text-zinc-300 leading-relaxed\">\n                Three crisp rounds\342\200\224runway presence, a 90-second talent showcase,\n                and spontaneous Q&amp;A. Winners take home the Epoch trophy and\n                annual fest VIP passes.\n              </p>\n            </div>\n          </article>\n\n          {/* Card 3: Architectural text card */}\n          <article className=\"rounded-xl border border-white/[0.08] bg-[#121216] p-6 sm:p-8 flex flex-col justify-between gap-6\">\n            <div>\n              <div className=\"flex items-center gap-2 text-xs text-zinc-400 font-mono tabular-nums mb-3\">\n                <span>19:15 \342\200\223 20:00</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>Grand Auditorium</span>\n              </div>\n              <h3 className=\"font-display text-2xl font-semibold text-white mb-3\">\n                03. Acoustic Sets &amp; Crew Showcases\n              </h3>\n              <p className=\"text-sm sm:text-base text-zinc-400 leading-relaxed\">\n                Unplugged vocals, indie guitar collaborations, and high-tempo\n                street choreography uniting first-year performers with AIML&apos;s\n                senior cultural crew.\n              </p>\n            </div>\n            <div className=\"pt-4 border-t border-white/[0.06] flex items-center justify-between text-sm\">\n              <span className=\"text-zinc-400\">Open audition slots</span>\n              <a\n                href=\"#spotlight\"\n                className=\"font-medium text-[#F5A623] hover:text-[#FFC04D] transition-colors whitespace-nowrap\"\n              >\n                Sign up to perform\n              </a>\n            </div>\n          </article>\n\n          {/* Card 4: 2-column dining & social proof card */}\n          <article className=\"lg:col-span-2 rounded-xl border border-white/[0.08] bg-[#121216] p-6 sm:p-8 flex flex-col justify-between gap-6\">\n            <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n              <div className=\"md:col-span-7\">\n                <div className=\"flex items-center gap-2 text-xs text-zinc-400 font-mono tabular-nums mb-3\">\n                  <span>All Evening</span>\n                  <span aria-hidden=\"true\">\302\267</span>\n                  <span>North Atrium &amp; Courtyard</span>\n                </div>\n                <h3 className=\"font-display text-2xl font-semibold text-white mb-3\">\n                  04. Courtyard Gala Dinner &amp; Polaroid Portrait Wall\n                </h3>\n                <p className=\"text-sm sm:text-base text-zinc-400 leading-relaxed\">\n                  Skip the standard cafeteria tray. Enjoy wood-fired sliders,\n                  live chaat stations, mezze bowls, zero-proof craft mocktails,\n                  and take home an instant-print portrait snapped with your\n                  new batchmates.\n                </p>\n              </div>\n              <div className=\"md:col-span-5 md:pl-6 md:border-l md:border-white/[0.08] space-y-4\">\n                <div>\n                  <div className=\"font-mono tabular-nums text-2xl font-medium text-white\">\n                    240+ Freshers\n                  </div>\n                  <div className=\"text-xs text-zinc-400 mt-0.5\">\n                    Sections A, B, C &amp; Lateral Entry united\n                  </div>\n                </div>\n                <div className=\"pt-3 border-t border-white/[0.06]\">\n                  <div className=\"font-mono tabular-nums text-2xl font-medium text-white\">\n                    3 Dining Counters\n                  </div>\n                  <div className=\"text-xs text-zinc-400 mt-0.5\">\n                    Dedicated Veg, Non-Veg &amp; Jain / Vegan lanes\n                  </div>\n                </div>\n              </div>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/HighlightsBento.tsx"
        }
        overwrite: true
      }
    }
