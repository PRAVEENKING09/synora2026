    }
    command_line: "trap \'playwright-cli close\' EXIT\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli run-code \'async (page) => {\n  await page.waitForLoadState(\"networkidle\");\n\n  // Click top nav Lineup link to test scroll-mt-20 clearance & improved scrims\n  await page.getByRole(\"link\", { name: \"Lineup\", exact: true }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \".playwright-cli/r2-lineup.png\" });\n\n  // Click Dress Code link to verify scroll-mt-20 and clean Participation Hub header layout\n  await page.getByRole(\"link\", { name: \"Dress Code\", exact: true }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \".playwright-cli/r2-showcase.png\" });\n\n  // Verify mobile hero kicker (no orphan dot) and mobile menu toggle\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.evaluate(() => window.scrollTo(0, 0));\n  await page.waitForTimeout(200);\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  await page.screenshot({ path: \".playwright-cli/r2-mobile.png\" });\n\n  // Test mobile menu open & close\n  await page.getByRole(\"button\", { name: \"Open navigation menu\" }).click();\n  const drawerVisible = await page.locator(\"#mobile-nav-drawer\").isVisible();\n  await page.getByRole(\"button\", { name: \"Close navigation menu\" }).click();\n  const drawerClosed = !(await page.locator(\"#mobile-nav-drawer\").isVisible());\n\n  console.log(\"R2_CHECKS:\", JSON.stringify({ mobileOverflow, drawerVisible, drawerClosed }));\n}\' && \\\nplaywright-cli console"
    proposed_command_line: "trap \'playwright-cli close\' EXIT\nplaywright-cli open --browser=chromium http://localhost:3000 && \\\nplaywright-cli resize 1440 900 && \\\nplaywright-cli run-code \'async (page) => {\n  await page.waitForLoadState(\"networkidle\");\n\n  // Click top nav Lineup link to test scroll-mt-20 clearance & improved scrims\n  await page.getByRole(\"link\", { name: \"Lineup\", exact: true }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \".playwright-cli/r2-lineup.png\" });\n\n  // Click Dress Code link to verify scroll-mt-20 and clean Participation Hub header layout\n  await page.getByRole(\"link\", { name: \"Dress Code\", exact: true }).first().click();\n  await page.waitForTimeout(350);\n  await page.screenshot({ path: \".playwright-cli/r2-showcase.png\" });\n\n  // Verify mobile hero kicker (no orphan dot) and mobile menu toggle\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.evaluate(() => window.scrollTo(0, 0));\n  await page.waitForTimeout(200);\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);\n  await page.screenshot({ path: \".playwright-cli/r2-mobile.png\" });\n\n  // Test mobile menu open & close\n  await page.getByRole(\"button\", { name: \"Open navigation menu\" }).click();\n  const drawerVisible = await page.locator(\"#mobile-nav-drawer\").isVisible();\n  await page.getByRole(\"button\", { name: \"Close navigation menu\" }).click();\n  const drawerClosed = !(await page.locator(\"#mobile-nav-drawer\").isVisible());\n\n  console.log(\"R2_CHECKS:\", JSON.stringify({ mobileOverflow, drawerVisible, drawerClosed }));\n}\' && \\\nplaywright-cli console"
    shell_name: "bash"
  }
}
