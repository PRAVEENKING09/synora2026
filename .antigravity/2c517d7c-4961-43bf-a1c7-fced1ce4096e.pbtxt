  code_action {
    action_spec {
      create_file {
        instruction: "import { useState, type FormEvent } from \'react\';\nimport {\n  AlertCircle,\n  ChevronDown,\n  ChevronUp,\n  CheckCircle2,\n  ThumbsUp,\n} from \'lucide-react\';\nimport {\n  DRESS_CODE_GUIDELINES,\n  EVENT_CONFIG,\n  EVENT_IMAGES,\n  FAQ_ITEMS,\n  type SongRequest,\n  type TalentCategory,\n  type TalentEntry,\n} from \'../data/eventData\';\nimport {\n  validateSongRequest,\n  validateTalentSubmission,\n  type SongValidationErrors,\n  type TalentValidationErrors,\n} from \'../utils/partyLogic\';\nimport { ResilientImage } from \'./ResilientImage\';\n\ninterface ShowcaseSectionProps {\n  songs: SongRequest[];\n  votedSongIds: string[];\n  onToggleSongVote: (songId: string) => void;\n  onAddSong: (title: string, artist: string, requestedBy: string) => void;\n  talentEntries: TalentEntry[];\n  onAddTalent: (entry: {\n    name: string;\n    rollNumber: string;\n    category: TalentCategory;\n    pitch: string;\n  }) => void;\n}\n\nconst TALENT_CATEGORIES: TalentCategory[] = [\n  \'Mr. & Ms. AIML\',\n  \'Solo Dance\',\n  \'Acoustic / Vocals\',\n  \'Stand-up / Poetry\',\n];\n\nexport function ShowcaseSection({\n  songs,\n  votedSongIds,\n  onToggleSongVote,\n  onAddSong,\n  talentEntries,\n  onAddTalent,\n}: ShowcaseSectionProps) {\n  const [activeTab, setActiveTab] = useState<\'songs\' | \'talent\'>(\'songs\');\n  const [openFaqId, setOpenFaqId] = useState<string>(FAQ_ITEMS[0].id);\n\n  // Song request form state\n  const [songTitle, setSongTitle] = useState(\'\');\n  const [songArtist, setSongArtist] = useState(\'\');\n  const [songRequester, setSongRequester] = useState(\'\');\n  const [songErrors, setSongErrors] = useState<SongValidationErrors>({});\n  const [songSuccess, setSongSuccess] = useState<string | null>(null);\n\n  // Talent audition form state\n  const [talentName, setTalentName] = useState(\'\');\n  const [talentRoll, setTalentRoll] = useState(\'\');\n  const [talentCategory, setTalentCategory] =\n    useState<TalentCategory>(\'Mr. & Ms. AIML\');\n  const [talentPitch, setTalentPitch] = useState(\'\');\n  const [talentErrors, setTalentErrors] = useState<TalentValidationErrors>({});\n  const [talentSuccess, setTalentSuccess] = useState<string | null>(null);\n\n  const handleSongSubmit = (e: FormEvent) => {\n    e.preventDefault();\n    setSongSuccess(null);\n    const errors = validateSongRequest(\n      { title: songTitle, artist: songArtist, requestedBy: songRequester },\n      songs\n    );\n    setSongErrors(errors);\n    if (Object.keys(errors).length > 0) return;\n\n    onAddSong(songTitle, songArtist, songRequester);\n    setSongSuccess(`Added \"${songTitle.trim()}\" to the courtyard DJ queue.`);\n    setSongTitle(\'\');\n    setSongArtist(\'\');\n    setSongRequester(\'\');\n  };\n\n  const handleTalentSubmit = (e: FormEvent) => {\n    e.preventDefault();\n    setTalentSuccess(null);\n    const errors = validateTalentSubmission({\n      name: talentName,\n      rollNumber: talentRoll,\n      category: talentCategory,\n      pitch: talentPitch,\n    });\n    setTalentErrors(errors);\n    if (Object.keys(errors).length > 0) return;\n\n    onAddTalent({\n      name: talentName,\n      rollNumber: talentRoll,\n      category: talentCategory,\n      pitch: talentPitch,\n    });\n    setTalentSuccess(\n      `Audition slot reserved for ${talentName.trim()} (${talentCategory}).`\n    );\n    setTalentName(\'\');\n    setTalentRoll(\'\');\n    setTalentPitch(\'\');\n  };\n\n  return (\n    <section\n      id=\"dresscode\"\n      className=\"py-16 lg:py-24 border-b border-white/[0.08]\"\n    >\n      <div className=\"max-w-[1280px] mx-auto px-6 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-start\">\n        {/* Left Column: Dress Code Lookbook + Venue Logistics FAQ */}\n        <div className=\"lg:col-span-5 space-y-12\">\n          <div>\n            <p className=\"text-sm text-[#F5A623] font-medium mb-2\">\n              Dress Code Lookbook\n            </p>\n            <h2 className=\"font-display text-3xl font-semibold tracking-tight text-white mb-4\">\n              Nocturnal Monochrome\n            </h2>\n            <p className=\"text-sm text-zinc-400 leading-relaxed mb-6\">\n              Clean silhouettes that photograph effortlessly under warm tungsten\n              courtyard lights and keep you comfortable through the afterparty.\n            </p>\n\n            <div className=\"relative rounded-xl overflow-hidden border border-white/[0.08] bg-[#121216] aspect-[4/3] sm:aspect-[3/4] max-h-[420px] w-full mb-6\">\n              <ResilientImage\n                src={EVENT_IMAGES.dressCodeLookbook}\n                alt=\"Two AIML students in smart nocturnal monochrome cocktail attire in a twilight glass pavilion\"\n                fallbackTitle=\"Nocturnal Monochrome Lookbook\"\n                className=\"w-full h-full object-cover object-top\"\n              />\n              <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#09090B]/80 via-transparent to-transparent\" />\n              <div className=\"absolute bottom-4 left-4 right-4 text-xs text-zinc-200 flex items-center justify-between\">\n                <span>Smart Cocktail &amp; Tailored Black</span>\n                <span className=\"font-mono text-zinc-300\">Gold / Slate Accents</span>\n              </div>\n            </div>\n\n            <dl className=\"divide-y divide-white/[0.08] border-y border-white/[0.08]\">\n              {DRESS_CODE_GUIDELINES.map((item) => (\n                <div key={item.heading} className=\"py-3.5 grid grid-cols-12 gap-3\">\n                  <dt className=\"col-span-4 text-xs font-medium text-white\">\n                    {item.heading}\n                  </dt>\n                  <dd className=\"col-span-8 text-xs text-zinc-400 leading-relaxed\">\n                    {item.detail}\n                  </dd>\n                </div>\n              ))}\n            </dl>\n          </div>\n\n          {/* Venue & Logistics Accordion */}\n          <div id=\"venue\" className=\"pt-2\">\n            <p className=\"text-sm text-[#F5A623] font-medium mb-2\">\n              Venue &amp; Logistics\n            </p>\n            <h3 className=\"font-display text-2xl font-semibold text-white mb-2\">\n              {EVENT_CONFIG.venueShort}\n            </h3>\n            <p className=\"text-sm text-zinc-400 mb-6\">{EVENT_CONFIG.venueFull}</p>\n\n            <div className=\"divide-y divide-white/[0.08] border-y border-white/[0.08]\">\n              {FAQ_ITEMS.map((faq) => {\n                const isOpen = openFaqId === faq.id;\n                return (\n                  <div key={faq.id}>\n                    <button\n                      type=\"button\"\n                      onClick={() => setOpenFaqId(isOpen ? \'\' : faq.id)}\n                      aria-expanded={isOpen}\n                      aria-controls={`faq-panel-${faq.id}`}\n                      className=\"w-full py-4 flex items-center justify-between gap-4 text-left text-sm font-medium text-white hover:text-[#F5A623] transition-colors\"\n                    >\n                      <span>{faq.question}</span>\n                      {isOpen ? (\n                        <ChevronUp\n                          className=\"w-4 h-4 shrink-0 text-[#F5A623]\"\n                          aria-hidden=\"true\"\n                        />\n                      ) : (\n                        <ChevronDown\n                          className=\"w-4 h-4 shrink-0 text-zinc-400\"\n                          aria-hidden=\"true\"\n                        />\n                      )}\n                    </button>\n                    {isOpen && (\n                      <div\n                        id={`faq-panel-${faq.id}`}\n                        className=\"pb-4 text-sm text-zinc-400 leading-relaxed\"\n                      >\n                        {faq.answer}\n                      </div>\n                    )}\n                  </div>\n                );\n              })}\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Interactive Party Hub (Song Requests & Talent Auditions) */}\n        <div\n          id=\"spotlight\"\n          className=\"lg:col-span-7 rounded-xl border border-white/[0.08] bg-[#121216] p-6 sm:p-8\"\n        >\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/[0.08]\">\n            <div>\n              <p className=\"text-sm text-[#F5A623] font-medium mb-1\">\n                Fresher Participation Hub\n              </p>\n              <h2 className=\"font-display text-2xl sm:text-3xl font-semibold text-white\">\n                Shape the soundtrack &amp; stage.\n              </h2>\n            </div>\n\n            <div\n              role=\"tablist\"\n              aria-label=\"Participation hub tabs\"\n              className=\"inline-flex items-center gap-1 p-1 rounded-lg bg-[#09090B] border border-white/[0.08] self-start sm:self-auto\"\n            >\n              <button\n                type=\"button\"\n                role=\"tab\"\n                id=\"tab-songs\"\n                aria-selected={activeTab === \'songs\'}\n                aria-controls=\"panel-songs\"\n                onClick={() => setActiveTab(\'songs\')}\n                className={`px-3.5 py-2 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                  activeTab === \'songs\'\n                    ? \'bg-[#F5A623] text-[#09090B]\'\n                    : \'text-zinc-300 hover:text-white\'\n                }`}\n              >\n                DJ Song Queue ({songs.length})\n              </button>\n              <button\n                type=\"button\"\n                role=\"tab\"\n                id=\"tab-talent\"\n                aria-selected={activeTab === \'talent\'}\n                aria-controls=\"panel-talent\"\n                onClick={() => setActiveTab(\'talent\')}\n                className={`px-3.5 py-2 text-xs sm:text-sm font-medium rounded-md transition-colors whitespace-nowrap shrink-0 ${\n                  activeTab === \'talent\'\n                    ? \'bg-[#F5A623] text-[#09090B]\'\n                    : \'text-zinc-300 hover:text-white\'\n                }`}\n              >\n                Mr. &amp; Ms. AIML / Talent ({talentEntries.length})\n              </button>\n            </div>\n          </div>\n\n          {activeTab === \'songs\' ? (\n            <div\n              id=\"panel-songs\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-songs\"\n              className=\"pt-6 space-y-8\"\n            >\n              <div>\n                <p className=\"text-sm text-zinc-400 mb-4\">\n                  Top-voted tracks go straight into DJ Aarav&apos;s courtyard\n                  encore set. Upvote your favorites or suggest a track below.\n                </p>\n\n                <ul\n                  data-testid=\"song-queue-list\"\n                  className=\"divide-y divide-white/[0.08] border-y border-white/[0.08]\"\n                >\n                  {songs.map((song, idx) => {\n                    const hasVoted = votedSongIds.includes(song.id);\n                    return (\n                      <li\n                        key={song.id}\n                        className=\"py-3.5 flex items-center justify-between gap-4\"\n                      >\n                        <div className=\"flex items-baseline gap-4 min-w-0\">\n                          <span className=\"font-mono tabular-nums text-xs text-zinc-500 w-5 shrink-0\">\n                            {String(idx + 1).padStart(2, \'0\')}\n                          </span>\n                          <div className=\"min-w-0\">\n                            <div className=\"text-sm sm:text-base font-medium text-white truncate\">\n                              {song.title}\n                            </div>\n                            <div className=\"text-xs text-zinc-400 flex flex-wrap items-center gap-x-2\">\n                              <span>{song.artist}</span>\n                              <span aria-hidden=\"true\">\302\267</span>\n                              <span>{song.requestedBy}</span>\n                            </div>\n                          </div>\n                        </div>\n\n                        <button\n                          type=\"button\"\n                          onClick={() => onToggleSongVote(song.id)}\n                          aria-pressed={hasVoted}\n                          aria-label={`${hasVoted ? \'Remove vote for\' : \'Upvote\'} ${song.title} by ${song.artist}`}\n                          className={`inline-flex items-center gap-2 px-3 py-2 text-xs font-mono tabular-nums rounded-lg border transition-colors whitespace-nowrap shrink-0 ${\n                            hasVoted\n                              ? \'bg-[#F5A623]/15 border-[#F5A623]/50 text-[#F5A623]\'\n                              : \'bg-transparent border-white/15 text-zinc-300 hover:border-white/30 hover:text-white\'\n                          }`}\n                        >\n                          <ThumbsUp className=\"w-3.5 h-3.5\" aria-hidden=\"true\" />\n                          <span>{song.votes}</span>\n                        </button>\n                      </li>\n                    );\n                  })}\n                </ul>\n              </div>\n\n              {/* Add Song Form */}\n              <form onSubmit={handleSongSubmit} noValidate className=\"space-y-4\">\n                <h3 className=\"font-display text-lg font-semibold text-white\">\n                  Request a Track\n                </h3>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label\n                      htmlFor=\"song-title\"\n                      className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                    >\n                      Song Title\n                    </label>\n                    <input\n                      id=\"song-title\"\n                      type=\"text\"\n                      value={songTitle}\n                      onChange={(e) => setSongTitle(e.target.value)}\n                      placeholder=\"e.g. Blinding Lights\"\n                      className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                    />\n                    {songErrors.title && (\n                      <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                        <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                        <span>{songErrors.title}</span>\n                      </p>\n                    )}\n                  </div>\n\n                  <div>\n                    <label\n                      htmlFor=\"song-artist\"\n                      className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                    >\n                      Artist\n                    </label>\n                    <input\n                      id=\"song-artist\"\n                      type=\"text\"\n                      value={songArtist}\n                      onChange={(e) => setSongArtist(e.target.value)}\n                      placeholder=\"e.g. The Weeknd\"\n                      className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                    />\n                    {songErrors.artist && (\n                      <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                        <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                        <span>{songErrors.artist}</span>\n                      </p>\n                    )}\n                  </div>\n                </div>\n\n                <div className=\"flex flex-col sm:flex-row sm:items-end gap-4\">\n                  <div className=\"flex-1\">\n                    <label\n                      htmlFor=\"song-requester\"\n                      className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                    >\n                      Your Name &amp; Section (Optional)\n                    </label>\n                    <input\n                      id=\"song-requester\"\n                      type=\"text\"\n                      value={songRequester}\n                      onChange={(e) => setSongRequester(e.target.value)}\n                      placeholder=\"e.g. Kabir S. \302\267 Sec B\"\n                      className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                    />\n                  </div>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                  >\n                    Add to Queue\n                  </button>\n                </div>\n\n                {songSuccess && (\n                  <p\n                    role=\"status\"\n                    className=\"text-xs text-emerald-400 flex items-center gap-1.5\"\n                  >\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n                    <span>{songSuccess}</span>\n                  </p>\n                )}\n              </form>\n            </div>\n          ) : (\n            <div\n              id=\"panel-talent\"\n              role=\"tabpanel\"\n              aria-labelledby=\"tab-talent\"\n              className=\"pt-6 space-y-8\"\n            >\n              <div>\n                <p className=\"text-sm text-zinc-400 mb-4\">\n                  Step onto the Grand Auditorium stage for Mr. &amp; Ms. AIML\n                  &apos;26 or open-mic showcases. Informal 5-minute screenings\n                  run Wednesday, Dec 9 in Seminar Hall 204.\n                </p>\n\n                <ul\n                  data-testid=\"talent-roster-list\"\n                  className=\"divide-y divide-white/[0.08] border-y border-white/[0.08]\"\n                >\n                  {talentEntries.map((entry) => (\n                    <li key={entry.id} className=\"py-3.5 space-y-1\">\n                      <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                        <span className=\"text-sm font-semibold text-white\">\n                          {entry.name}\n                        </span>\n                        <span className=\"text-xs text-zinc-400 font-mono\">\n                          {entry.rollNumber} \302\267{\' \'}\n                          <span className=\"text-[#F5A623] font-sans font-medium\">\n                            {entry.category}\n                          </span>\n                        </span>\n                      </div>\n                      <p className=\"text-xs sm:text-sm text-zinc-400\">\n                        {entry.pitch}\n                      </p>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n\n              <form onSubmit={handleTalentSubmit} noValidate className=\"space-y-4\">\n                <h3 className=\"font-display text-lg font-semibold text-white\">\n                  Reserve an Audition Slot\n                </h3>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label\n                      htmlFor=\"talent-name\"\n                      className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                    >\n                      Full Name\n                    </label>\n                    <input\n                      id=\"talent-name\"\n                      type=\"text\"\n                      value={talentName}\n                      onChange={(e) => setTalentName(e.target.value)}\n                      placeholder=\"e.g. Nikhil Rao\"\n                      className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                    />\n                    {talentErrors.name && (\n                      <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                        <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                        <span>{talentErrors.name}</span>\n                      </p>\n                    )}\n                  </div>\n\n                  <div>\n                    <label\n                      htmlFor=\"talent-roll\"\n                      className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                    >\n                      Roll Number\n                    </label>\n                    <input\n                      id=\"talent-roll\"\n                      type=\"text\"\n                      value={talentRoll}\n                      onChange={(e) => setTalentRoll(e.target.value)}\n                      placeholder=\"e.g. 26AIML105\"\n                      className=\"w-full px-3.5 py-2.5 text-sm font-mono bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                    />\n                    {talentErrors.rollNumber && (\n                      <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                        <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                        <span>{talentErrors.rollNumber}</span>\n                      </p>\n                    )}\n                  </div>\n                </div>\n\n                <div>\n                  <label\n                    htmlFor=\"talent-category\"\n                    className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                  >\n                    Category\n                  </label>\n                  <select\n                    id=\"talent-category\"\n                    value={talentCategory}\n                    onChange={(e) =>\n                      setTalentCategory(e.target.value as TalentCategory)\n                    }\n                    className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white focus:border-[#F5A623]\"\n                  >\n                    {TALENT_CATEGORIES.map((cat) => (\n                      <option key={cat} value={cat}>\n                        {cat}\n                      </option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label\n                    htmlFor=\"talent-pitch\"\n                    className=\"block text-xs font-medium text-zinc-300 mb-1.5\"\n                  >\n                    Act Description or Introduction Note\n                  </label>\n                  <textarea\n                    id=\"talent-pitch\"\n                    rows={2}\n                    value={talentPitch}\n                    onChange={(e) => setTalentPitch(e.target.value)}\n                    placeholder=\"Briefly describe your song, dance style, or pageant talent round...\"\n                    className=\"w-full px-3.5 py-2.5 text-sm bg-[#09090B] border border-white/15 rounded-lg text-white placeholder:text-zinc-500 focus:border-[#F5A623]\"\n                  />\n                  {talentErrors.pitch && (\n                    <p className=\"mt-1.5 text-xs text-rose-400 flex items-center gap-1.5\">\n                      <AlertCircle className=\"w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\" />\n                      <span>{talentErrors.pitch}</span>\n                    </p>\n                  )}\n                </div>\n\n                <div className=\"flex flex-wrap items-center justify-between gap-4\">\n                  <span className=\"text-xs text-zinc-400\">\n                    Open exclusively to 1st-year AIML students.\n                  </span>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2.5 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap shrink-0\"\n                  >\n                    Reserve Slot\n                  </button>\n                </div>\n\n                {talentSuccess && (\n                  <p\n                    role=\"status\"\n                    className=\"text-xs text-emerald-400 flex items-center gap-1.5\"\n                  >\n                    <CheckCircle2 className=\"w-4 h-4 shrink-0\" aria-hidden=\"true\" />\n                    <span>{talentSuccess}</span>\n                  </p>\n                )}\n              </form>\n            </div>\n          )}\n        </div>\n      </div>\n    </section>\n  );\n}\n"
