  code_action {
    action_spec {
      create_file {
        instruction: "import { EVENT_CONFIG } from \'../data/eventData\';\nimport { generateQrMatrix, type IssuedPass } from \'./partyLogic\';\n\n/**\n * Renders an official Epoch \'26 digital entry pass onto an offscreen canvas\n * and triggers a PNG file download.\n */\nexport function downloadPassAsPng(pass: IssuedPass): boolean {\n  if (typeof document === \'undefined\') return false;\n\n  const width = 960;\n  const height = 520;\n  const canvas = document.createElement(\'canvas\');\n  canvas.width = width;\n  canvas.height = height;\n\n  const ctx = canvas.getContext(\'2d\');\n  if (!ctx) return false;\n\n  // Obsidian background\n  ctx.fillStyle = \'#09090B\';\n  ctx.fillRect(0, 0, width, height);\n\n  // Subtle card frame\n  ctx.fillStyle = \'#121216\';\n  ctx.strokeStyle = \'rgba(255,255,255,0.14)\';\n  ctx.lineWidth = 2;\n  ctx.beginPath();\n  ctx.roundRect(28, 28, width - 56, height - 56, 18);\n  ctx.fill();\n  ctx.stroke();\n\n  // Top amber hairline\n  ctx.fillStyle = \'#F5A623\';\n  ctx.fillRect(28, 28, width - 56, 5);\n\n  // Vertical perforation divider\n  ctx.save();\n  ctx.strokeStyle = \'rgba(255,255,255,0.14)\';\n  ctx.setLineDash([6, 6]);\n  ctx.beginPath();\n  ctx.moveTo(640, 56);\n  ctx.lineTo(640, height - 56);\n  ctx.stroke();\n  ctx.restore();\n\n  // Left side content\n  ctx.fillStyle = \'#F5A623\';\n  ctx.font = \'600 16px sans-serif\';\n  ctx.fillText(\n    `${EVENT_CONFIG.department} \302\267 ${EVENT_CONFIG.batchLabel}`,\n    64,\n    88\n  );\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'700 44px sans-serif\';\n  ctx.fillText(`${EVENT_CONFIG.brandName} Entry Pass`, 64, 146);\n\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'400 18px sans-serif\';\n  ctx.fillText(\n    `${EVENT_CONFIG.dateDisplay} \302\267 ${EVENT_CONFIG.timeDisplay}`,\n    64,\n    182\n  );\n\n  // Divider line\n  ctx.strokeStyle = \'rgba(255,255,255,0.1)\';\n  ctx.beginPath();\n  ctx.moveTo(64, 212);\n  ctx.lineTo(604, 212);\n  ctx.stroke();\n\n  // Attendee details\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 14px sans-serif\';\n  ctx.fillText(\'ATTENDEE\', 64, 248);\n\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.font = \'600 30px sans-serif\';\n  ctx.fillText(pass.fullName, 64, 286);\n\n  ctx.fillStyle = \'#D4D4D8\';\n  ctx.font = \'500 17px monospace\';\n  ctx.fillText(`${pass.rollNumber}  \302\267  ${pass.section}`, 64, 320);\n\n  // Lower metadata row\n  const drawField = (label: string, value: string, x: number, y: number) => {\n    ctx.fillStyle = \'#A1A1AA\';\n    ctx.font = \'500 13px sans-serif\';\n    ctx.fillText(label, x, y);\n    ctx.fillStyle = \'#F4F4F5\';\n    ctx.font = \'600 18px sans-serif\';\n    ctx.fillText(value, x, y + 26);\n  };\n\n  drawField(\'ENTRY GATE\', pass.gate, 64, 378);\n  drawField(\'DINING LANE\', pass.diningCode, 340, 378);\n  drawField(\'TRACK\', pass.track, 455, 378);\n\n  // Right stub: QR code & pass ID\n  const qrSize = 17;\n  const cell = 10;\n  const qrPixelSize = qrSize * cell;\n  const qrX = 640 + Math.floor((width - 28 - 640 - qrPixelSize) / 2);\n  const qrY = 120;\n\n  // White quiet zone behind QR\n  ctx.fillStyle = \'#FFFFFF\';\n  ctx.beginPath();\n  ctx.roundRect(qrX - 16, qrY - 16, qrPixelSize + 32, qrPixelSize + 32, 10);\n  ctx.fill();\n\n  const matrix = generateQrMatrix(pass.passCode, qrSize);\n  ctx.fillStyle = \'#09090B\';\n  for (let r = 0; r < qrSize; r += 1) {\n    for (let c = 0; c < qrSize; c += 1) {\n      if (matrix[r][c]) {\n        ctx.fillRect(qrX + c * cell, qrY + r * cell, cell, cell);\n      }\n    }\n  }\n\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'500 13px sans-serif\';\n  ctx.textAlign = \'center\';\n  ctx.fillText(\'PASS CODE\', 786, 355);\n\n  ctx.fillStyle = \'#F5A623\';\n  ctx.font = \'600 24px monospace\';\n  ctx.fillText(pass.passCode, 786, 388);\n\n  ctx.fillStyle = \'#A1A1AA\';\n  ctx.font = \'400 13px sans-serif\';\n  ctx.fillText(\'Present with College ID\', 786, 434);\n\n  const link = document.createElement(\'a\');\n  link.download = `epoch26-pass-${pass.rollNumber.toLowerCase()}.png`;\n  link.href = canvas.toDataURL(\'image/png\');\n  document.body.appendChild(link);\n  link.click();\n  document.body.removeChild(link);\n\n  return true;\n}\n"
        path {
          absolute_uri: "file:///src/utils/passExport.ts"
        }
        overwrite: true
      }
    }
