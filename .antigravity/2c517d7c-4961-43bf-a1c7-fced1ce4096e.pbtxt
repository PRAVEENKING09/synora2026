  code_action {
    action_spec {
      create_file {
        instruction: "import { useEffect, useState } from \'react\';\nimport { ArrowDownRight } from \'lucide-react\';\nimport { EVENT_CONFIG, EVENT_IMAGES } from \'../data/eventData\';\nimport { getCountdownParts, padTwo } from \'../utils/partyLogic\';\nimport { ResilientImage } from \'./ResilientImage\';\n\ninterface HeroSectionProps {\n  hasIssuedPass: boolean;\n}\n\nexport function HeroSection({ hasIssuedPass }: HeroSectionProps) {\n  const targetMs = new Date(EVENT_CONFIG.eventStartIso).getTime();\n  const [nowMs, setNowMs] = useState<number>(() => Date.now());\n\n  useEffect(() => {\n    const interval = window.setInterval(() => {\n      setNowMs(Date.now());\n    }, 1000);\n    return () => window.clearInterval(interval);\n  }, []);\n\n  const countdown = getCountdownParts(targetMs, nowMs);\n\n  return (\n    <section\n      id=\"top\"\n      className=\"border-b border-white/[0.08] bg-[#09090B]\"\n    >\n      <div className=\"max-w-[1280px] mx-auto px-6 pt-12 pb-12 lg:pt-16 lg:pb-16\">\n        {/* 2-Column Asymmetric Split with items-stretch */}\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch\">\n          <div className=\"lg:col-span-5 flex flex-col justify-between gap-8\">\n            <div className=\"space-y-6\">\n              <p className=\"text-sm text-zinc-400 flex flex-wrap items-center gap-x-2 gap-y-1\">\n                <span className=\"text-[#F5A623] font-medium\">\n                  {EVENT_CONFIG.department}\n                </span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>{EVENT_CONFIG.batchLabel}</span>\n              </p>\n\n              <h1\n                className=\"font-display font-semibold tracking-tight text-white leading-[1.06]\"\n                style={{ fontSize: \'clamp(2.35rem, 4.1vw, 3.75rem)\' }}\n              >\n                Welcome to your first evening at AIML.\n              </h1>\n\n              <p className=\"text-base leading-relaxed text-zinc-300 max-w-lg\">\n                An evening curated by the senior batch to celebrate the incoming\n                Class of 2030\342\200\224featuring live stage performances, the Mr. &amp;\n                Ms. AIML pageant, courtyard dining, and an open-air DJ\n                afterparty.\n              </p>\n            </div>\n\n            <div className=\"flex flex-wrap items-center gap-6 pt-2\">\n              <a\n                href=\"#rsvp\"\n                className=\"inline-flex items-center justify-center px-6 py-3 text-sm font-semibold text-[#09090B] bg-[#F5A623] hover:bg-[#FFC04D] rounded-lg transition-colors whitespace-nowrap shrink-0\"\n              >\n                {hasIssuedPass ? \'Open My Entry Pass\' : \'Claim Entry Pass\'}\n              </a>\n\n              <a\n                href=\"#schedule\"\n                className=\"inline-flex items-center gap-1.5 text-sm font-medium text-zinc-300 hover:text-white transition-colors whitespace-nowrap shrink-0\"\n              >\n                <span>Explore Schedule</span>\n                <ArrowDownRight className=\"w-4 h-4 text-[#F5A623]\" aria-hidden=\"true\" />\n              </a>\n            </div>\n          </div>\n\n          <div className=\"lg:col-span-7 relative rounded-xl overflow-hidden border border-white/[0.08] bg-[#121216] min-h-[280px] sm:min-h-[380px] lg:min-h-[440px]\">\n            <ResilientImage\n              src={EVENT_IMAGES.heroGala}\n              alt=\"AIML students celebrating under warm tungsten spotlights in the Grand Auditorium and glass courtyard\"\n              fallbackTitle=\"Epoch \'26 \342\200\224 Grand Auditorium & Courtyard\"\n              loading=\"eager\"\n              className=\"w-full h-full object-cover lg:absolute lg:inset-0\"\n            />\n            <div className=\"pointer-events-none absolute inset-0 bg-gradient-to-t from-[#09090B]/85 via-[#09090B]/20 to-transparent\" />\n            <div className=\"absolute bottom-5 left-5 right-5 flex flex-wrap items-end justify-between gap-3\">\n              <div className=\"text-sm text-zinc-200 font-medium\">\n                {EVENT_CONFIG.venueShort}\n              </div>\n              <div className=\"text-xs font-mono tabular-nums text-zinc-300\">\n                Doors open 18:00 \302\267 Free entry for AIML 1st Year\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Full-width 4-column Event Essentials Strip below hero split */}\n        <div className=\"mt-10 pt-8 border-t border-white/[0.08] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 lg:divide-x lg:divide-white/[0.08]\">\n          <div className=\"lg:pr-6\">\n            <div className=\"text-xs text-zinc-400 mb-1.5\">Countdown to Doors</div>\n            {countdown.isLive ? (\n              <div className=\"font-mono text-lg font-medium text-[#F5A623]\">\n                Doors Open Tonight\n              </div>\n            ) : (\n              <div\n                data-testid=\"hero-countdown\"\n                className=\"font-mono tabular-nums text-xl font-medium text-white tracking-tight\"\n              >\n                {padTwo(countdown.days)}d{\' \'}\n                <span className=\"text-zinc-500\">:</span> {padTwo(countdown.hours)}h{\' \'}\n                <span className=\"text-zinc-500\">:</span> {padTwo(countdown.minutes)}m{\' \'}\n                <span className=\"text-zinc-500\">:</span> {padTwo(countdown.seconds)}s\n              </div>\n            )}\n          </div>\n\n          <div className=\"lg:px-6\">\n            <div className=\"text-xs text-zinc-400 mb-1.5\">Date &amp; Hours</div>\n            <div className=\"text-base font-medium text-white\">\n              {EVENT_CONFIG.dateDisplay}\n            </div>\n            <div className=\"text-sm text-zinc-400 font-mono tabular-nums mt-0.5\">\n              {EVENT_CONFIG.timeDisplay}\n            </div>\n          </div>\n\n          <div className=\"lg:px-6\">\n            <div className=\"text-xs text-zinc-400 mb-1.5\">Venue</div>\n            <div className=\"text-base font-medium text-white\">\n              Block C Auditorium\n            </div>\n            <div className=\"text-sm text-zinc-400 mt-0.5\">\n              &amp; North Courtyard Lawn\n            </div>\n          </div>\n\n          <div className=\"lg:pl-6\">\n            <div className=\"text-xs text-zinc-400 mb-1.5\">Dress Code</div>\n            <div className=\"text-base font-medium text-white\">\n              {EVENT_CONFIG.dressCodeShort}\n            </div>\n            <div className=\"text-sm text-zinc-400 mt-0.5\">\n              Smart cocktail \302\267 Black, slate &amp; gold\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/components/HeroSection.tsx"
        }
        overwrite: true
      }
    }
