      full: "### Browser `default` opened with pid 412.### Ran Playwright code```jsawait page.goto(\'http://localhost:3000\');```### Page- Page URL: http://localhost:3000/- Page Title: Epoch \'26 \342\200\224 AIML Department Freshers\' Night### Snapshot- [Snapshot](.playwright-cli/page-2026-11-21T15-06-57-713Z.yml)### Events- New console entries: .playwright-cli/console-2026-11-21T15-06-55-318Z.log#L1### Ran Playwright code```jsawait page.setViewportSize({ width: 1440, height: 900 });```### Ran Playwright code```jsawait (async (page) => {  const report = {};  await page.waitForLoadState(\"networkidle\");  report.desktopOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);  report.images = await page.evaluate(() =>    Array.from(document.querySelectorAll(\"img\")).map(img => ({      alt: img.alt.slice(0, 35),      complete: img.complete,      naturalWidth: img.naturalWidth    }))  );  // Capture Highlights Bento section  await page.locator(\"#lineup\").scrollIntoViewIfNeeded();  await page.waitForTimeout(150);  await page.screenshot({ path: \".playwright-cli/r1-lineup.png\" });  // Journey 2: Schedule filtering & bookmarking  await page.locator(\"#schedule\").scrollIntoViewIfNeeded();  await page.getByRole(\"button\", { name: \"Stage\", exact: true }).click();  report.stageCount = await page.locator(\"[data-testid=\\\"schedule-list\\\"] > div\").count();  await page.getByRole(\"button\", { name: /Add Mr\\. & Ms\\. AIML 2026 Pageant to my plan/i }).click();  await page.getByRole(\"button\", { name: \"My Plan (1)\", exact: true }).click();  report.savedCount = await page.locator(\"[data-testid=\\\"schedule-list\\\"] > div\").count();  // Journey 3: DJ Song Queue upvote & add, plus Talent Audition tab  await page.locator(\"#spotlight\").scrollIntoViewIfNeeded();  const upvoteBtn = page.getByRole(\"button\", { name: /Upvote Starboy/i });  const beforeVoteText = await upvoteBtn.innerText();  await upvoteBtn.click();  const afterVoteText = await page.getByRole(\"button\", { name: /Remove vote for Starboy/i }).innerText();  report.songVoteChange = { before: beforeVoteText.trim(), after: afterVoteText.trim() };  await page.getByLabel(\"Song Title\").fill(\"Blinding Lights\");  await page.getByLabel(\"Artist\").fill(\"The Weeknd\");  await page.getByLabel(/Your Name & Section/i).fill(\"Ananya \302\267 Sec B\");  await page.getByRole(\"button\", { name: \"Add to Queue\", exact: true }).click();  report.songAddedVisible = await page.locator(\"[data-testid=\\\"song-queue-list\\\"]\").getByText(\"Blinding Lights\").isVisible();  await page.screenshot({ path: \".playwright-cli/r1-showcase.png\" });  await page.getByRole(\"tab\", { name: /Mr\\. & Ms\\. AIML \\/ Talent/i }).click();  await page.locator(\"#talent-name\").fill(\"Nikhil Rao\");  await page.locator(\"#talent-roll\").fill(\"26AIML105\");  await page.locator(\"#talent-pitch\").fill(\"A 3-minute stand-up comedy set about surviving first-semester Python labs.\");  await page.getByRole(\"button\", { name: \"Reserve Slot\", exact: true }).click();  report.talentAddedVisible = await page.locator(\"[data-testid=\\\"talent-roster-list\\\"]\").getByText(\"Nikhil Rao\").isVisible();  // Journey 1: RSVP validation + Pass generation + Persistence  await page.locator(\"#rsvp\").scrollIntoViewIfNeeded();  await page.getByRole(\"button\", { name: \"Generate Entry Pass\", exact: true }).click();  report.rsvpValidationShown = await page.getByText(/Enter your full name/i).isVisible();  await page.locator(\"#rsvp-name\").fill(\"Ananya Sharma\");  await page.locator(\"#rsvp-roll\").fill(\"26AIML042\");  await page.locator(\"#rsvp-email\").fill(\"ananya.sharma@aiml.edu\");  await page.locator(\"#rsvp-section\").selectOption(\"Section B\");  await page.locator(\"#rsvp-dining\").selectOption(\"Vegetarian\");  await page.getByRole(\"button\", { name: \"Generate Entry Pass\", exact: true }).click();  report.passIssuedVisible = await page.locator(\"[data-testid=\\\"digital-entry-pass\\\"]\").getByText(\"Pass Issued\").isVisible();  report.passNameVisible = await page.locator(\"[data-testid=\\\"digital-entry-pass\\\"]\").getByText(\"Ananya Sharma\").isVisible();  await page.screenshot({ path: \".playwright-cli/r1-rsvp-pass.png\" });  // Reload to verify persistence  await page.reload({ waitUntil: \"networkidle\" });  await page.locator(\"#rsvp\").scrollIntoViewIfNeeded();  report.persistedAfterReload = await page.locator(\"[data-testid=\\\"digital-entry-pass\\\"]\").getByText(\"Ananya Sharma\").isVisible()    && await page.locator(\"[data-testid=\\\"digital-entry-pass\\\"]\").getByText(\"Pass Issued\").isVisible();  // Mobile viewport check  await page.setViewportSize({ width: 390, height: 844 });  await page.evaluate(() => window.scrollTo(0, 0));  await page.waitForTimeout(200);  report.mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth > window.innerWidth);  report.mobileHeaderHeight = await page.evaluate(() => document.querySelector(\"header\")?.getBoundingClientRect().height || 0);  await page.screenshot({ path: \".playwright-cli/r1-mobile.png\" });  console.log(\"VERIFICATION_REPORT:\", JSON.stringify(report, null, 2));})(page);```### Events- New console entries: .playwright-cli/console-2026-11-21T15-06-55-318Z.log#L2### ResultTotal messages: 3 (Errors: 0, Warnings: 0)Returning 1 messages for level \"info\"[INFO] %cDownload the React DevTools for a better development experience: https://react.dev/link/react-devtools font-weight:bold @ http://localhost:3000/node_modules/.vite/deps/react-dom_client.js?v=59c2845c:15801Browser \'default\' closed\n\n### Latest snapshot (.playwright-cli/page-2026-11-21T15-06-57-713Z.yml)\n```yaml\n- generic [ref=e3]:\n  - banner [ref=e4]:\n    - generic [ref=e5]:\n      - link \"Epoch \'26\" [ref=e6] [cursor=pointer]:\n        - /url: \"#top\"\n      - navigation \"Primary navigation\" [ref=e7]:\n        - link \"Lineup\" [ref=e8] [cursor=pointer]:\n          - /url: